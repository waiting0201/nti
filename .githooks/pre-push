#!/usr/bin/env bash
# 安全網：絕不讓不該公開的內容推向 Remote_GitHub（public repo）。
#
# 兩道檢查：
#   1. 路徑：reference/ planning/ mockup/ mockup2/ .wrangler/ db/local/
#      （planning/ 是 reference/ 的前身，只存在於舊 commit —— 光看現在的樹會漏掉）
#   2. 體積：全歷史可達物件 > 20MB 即拒絕。路徑清單可能漏，體積不會。
remote="$1"
[ "$remote" = "Remote_GitHub" ] || exit 0

z40=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue

    hit=$(git rev-list --objects "$local_sha" \
          | grep -E ' (reference|planning|mockup|mockup2|\.wrangler|db/local)(/|$)' \
          | head -3 || true)
    if [ -n "$hit" ]; then
        echo "" >&2
        echo "pre-push 拒絕：$local_ref 的歷史含不應公開的路徑。" >&2
        echo "$hit" | sed 's/^[0-9a-f]* /    /' >&2
        echo "  請用 tools/sync-public.sh 產生 public 分支後再推。" >&2
        echo "" >&2
        exit 1
    fi

    mb=$(git rev-list --objects "$local_sha" | awk '{print $1}' \
         | git cat-file --batch-check='%(objectsize)' 2>/dev/null \
         | awk '{s+=$1} END {printf "%.0f", s/1048576}')
    if [ "${mb:-0}" -gt 20 ]; then
        echo "" >&2
        echo "pre-push 拒絕：$local_ref 全歷史可達物件 ${mb} MB，超過 20MB 上限。" >&2
        echo "  公開版應只有 docs/db/tools，約 1MB。請檢查 EXCLUDE 是否漏了歷史目錄。" >&2
        echo "" >&2
        exit 1
    fi
done
exit 0
